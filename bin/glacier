#!/usr/bin/env bash

set -euo pipefail

DEST="$HOME/glacier"
APPLY=0
YES=0
QUERY=""
ROOTS=()
OWN_RE='borestad|codeitse|gist\.github\.com'
HAS_GUM=0
LABEL_WIDTH=6
LABEL_MINE=''
LABEL_3P=''

printf -v LABEL_MINE "%-${LABEL_WIDTH}s" "mine"
printf -v LABEL_3P "%-${LABEL_WIDTH}s" "3p"

if ! command -v fd >/dev/null 2>&1; then
  echo "Missing dependency: fd is required." >&2
  exit 1
fi

if command -v gum >/dev/null 2>&1; then
  HAS_GUM=1
  LABEL_MINE="$(gum style --foreground 255 --background 29 --width "$LABEL_WIDTH" --align center 'mine')"
  LABEL_3P="$(gum style --foreground 255 --background 240 --width "$LABEL_WIDTH" --align center '3p')"
fi

usage() {
  cat <<'EOF'
Usage:
  glacier [options] <fd-pattern>

Search files with fd and move matches into ~/glacier while preserving
the path relative to your home directory.

Options:
  --root <path>   Add a search root (can be repeated)
  --apply         Perform the move (default is preview only)
  --yes           Skip confirmation prompt (only with --apply)
  -h, --help      Show this help

Examples:
  glacier '\.zip$'
  glacier --root ~/code --root ~/Downloads 'backup'
  glacier --apply '.*\.log$'
EOF
}

resolve_dst() {
  local base="$1"
  local candidate="$base"
  local n=1

  while [[ -e "$candidate" || -n "${RESERVED[$candidate]:-}" ]]; do
    candidate="${base}__${n}"
    ((n+=1))
  done

  printf '%s' "$candidate"
}

display_path() {
  local path="$1"
  if [[ "$path" == "$HOME" ]]; then
    printf '~'
    return
  fi
  if [[ "$path" == "$HOME/"* ]]; then
    printf '~/%s' "${path#"$HOME"/}"
    return
  fi
  printf '%s' "$path"
}

age_from_epoch() {
  local ts="$1"
  local now delta
  now="$(date +%s)"
  delta=$((now - ts))
  if ((delta < 0)); then
    delta=0
  fi
  if ((delta < 60)); then
    printf '%ss' "$delta"
    return
  fi
  if ((delta < 3600)); then
    printf '%sm' "$((delta / 60))"
    return
  fi
  if ((delta < 86400)); then
    printf '%sh' "$((delta / 3600))"
    return
  fi
  if ((delta < 2592000)); then
    printf '%sd' "$((delta / 86400))"
    return
  fi
  if ((delta < 31536000)); then
    printf '%smo' "$((delta / 2592000))"
    return
  fi
  printf '%sy' "$((delta / 31536000))"
}

dir_size() {
  local dir="$1"
  du -sh "$dir" 2>/dev/null | awk '{print $1}'
}

dir_file_count() {
  local dir="$1"
  fd --type f --exclude .git --exclude node_modules . "$dir" 2>/dev/null | wc -l | tr -d ' '
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --root)
      [[ $# -lt 2 ]] && { echo "Missing value for --root" >&2; exit 1; }
      ROOTS+=("$2")
      shift 2
      ;;
    --apply)
      APPLY=1
      shift
      ;;
    --yes)
      YES=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ -z "$QUERY" ]]; then
        QUERY="$1"
      else
        echo "Unexpected argument: $1" >&2
        usage
        exit 1
      fi
      shift
      ;;
  esac
done

if [[ -z "$QUERY" && ${#ROOTS[@]} -eq 0 ]]; then
  echo "Auto mode: folders in ~/code with labels:"
  if [[ -d "$HOME/code" ]]; then
    mapfile -t CODE_DIRS < <(fd --type d --min-depth 1 --max-depth 1 . "$HOME/code" 2>/dev/null || true)
    if [[ ${#CODE_DIRS[@]} -gt 0 ]]; then
      for dir in "${CODE_DIRS[@]}"; do
        label="$LABEL_3P"
        size="$(dir_size "$dir")"
        files="$(dir_file_count "$dir")"
        git_state="no-git"
        last_age="-"
        if [[ -d "$dir/.git" ]]; then
          git_state="clean"
          status_out="$(git -C "$dir" status --porcelain=v2 -uno 2>/dev/null || true)"
          if [[ -z "$status_out" ]]; then
            status_out="$(git -C "$dir" status --porcelain -uno 2>/dev/null || true)"
          fi
          [[ -n "$status_out" ]] && git_state="dirty"
          last_ts="$(git -C "$dir" log -1 --format=%ct 2>/dev/null || true)"
          if [[ -n "$last_ts" ]]; then
            last_age="$(age_from_epoch "$last_ts")"
          else
            last_age="no-commits"
          fi
          origin="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
          if [[ "$origin" =~ $OWN_RE ]]; then
            label="$LABEL_MINE"
          fi
        fi
        echo "  $label $(display_path "$dir")  size:$size  files:$files  git:$git_state  last:$last_age"
      done
    else
      echo "  (no folders found)"
    fi
  else
    echo "  (~/code does not exist)"
  fi
  exit 0
fi

if [[ -z "$QUERY" ]]; then
  usage
  exit 1
fi

if [[ ${#ROOTS[@]} -eq 0 ]]; then
  ROOTS=("$HOME/code" "$HOME/Downloads" "$HOME/Desktop" "$HOME/Documents")
fi

FD_CMD=(
  fd
  --type f
  --absolute-path
  --print0
  --exclude .git
  --exclude node_modules
  --exclude "$(basename "$DEST")"
  "$QUERY"
)
FD_CMD+=("${ROOTS[@]}")

mapfile -d '' RAW_FILES < <("${FD_CMD[@]}" 2>/dev/null || true)

FILES=()
for src in "${RAW_FILES[@]}"; do
  if [[ "$src" == "$DEST" || "$src" == "$DEST/"* ]]; then
    continue
  fi
  FILES+=("$src")
done

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "No files matched '$QUERY'."
  exit 0
fi

declare -A RESERVED=()
MOVE_SRC=()
MOVE_DST=()

for src in "${FILES[@]}"; do
  if [[ "$src" == "$HOME/"* ]]; then
    rel="${src#"$HOME"/}"
  else
    rel="$(basename "$src")"
  fi
  dst_base="$DEST/$rel"
  dst_final="$(resolve_dst "$dst_base")"
  RESERVED["$dst_final"]=1
  MOVE_SRC+=("$src")
  MOVE_DST+=("$dst_final")
done

echo "Matched ${#MOVE_SRC[@]} file(s):"
echo "Preflight move plan (src -> dst):"
for i in "${!MOVE_SRC[@]}"; do
  src_display="$(display_path "${MOVE_SRC[$i]}")"
  dst_display="$(display_path "${MOVE_DST[$i]}")"
  echo "  $src_display -> $dst_display"
done

if [[ $APPLY -eq 0 ]]; then
  echo
  echo "Preview only. Re-run with --apply to move files."
  exit 0
fi

if [[ $YES -eq 0 ]]; then
  echo
  read -r -p "Move these files to $DEST? [y/N] " reply
  if [[ ! "$reply" =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
  fi
fi

mkdir -p "$DEST"
LOG_FILE="$DEST/move.log"
touch "$LOG_FILE"
MOVED=0

for i in "${!MOVE_SRC[@]}"; do
  src="${MOVE_SRC[$i]}"
  dst="${MOVE_DST[$i]}"
  mkdir -p "$(dirname "$dst")"
  mv "$src" "$dst"
  ts="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  printf '%s\t%s\t%s\n' "$ts" "$src" "$dst" >> "$LOG_FILE"
  ((MOVED+=1))
done

echo
echo "Moved: $MOVED"
echo "Manifest: $(display_path "$LOG_FILE")"
