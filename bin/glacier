#!/usr/bin/env bash

set -euo pipefail

# Quick repo dashboard for ~/code.
# Builds/reuses a cached mr repo list, probes each repo for local/remote git state,
# and prints a mine-first overview (compact icons by default, full text with --verbose).

HOME_DIR="${HOME:?}"
BIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROBE="$BIN_DIR/glacier-probe"

CODE_ROOT="$HOME_DIR/code"
OWN_RE='borestad|codeitse|gist\.github\.com'

CACHE_DIR="$HOME_DIR/.cache/glacier"
CACHE_CONFIG="$CACHE_DIR/mrconfig"
CACHE_HOME="$CACHE_DIR/mr-home"

MR_JOBS="${MR_JOBS:-6}"

LABEL_W=6
STATUS_W=20
REMOTE_W=14
LAST_W=6
ICON_W=2

REBUILD=0
VERBOSE=0
USE_COLOR=0

LABEL_MINE=""
LABEL_3P=""

usage() {
  cat <<'USAGE'
Usage: glacier [--rebuild] [--verbose]

Options:
  --rebuild  Rebuild repo list cache from ~/code
  --verbose  Show text status columns instead of compact icon view
USAGE
}

die() {
  echo "$*" >&2
  exit 1
}

display_path() {
  local path="$1"
  if [[ "$path" == "$HOME_DIR" ]]; then
    printf '~'
  elif [[ "$path" == "$HOME_DIR/"* ]]; then
    printf '~/%s' "${path#"$HOME_DIR"/}"
  else
    printf '%s' "$path"
  fi
}

age_from_epoch() {
  local ts="$1"
  local now delta
  now="$(date +%s)"
  delta=$((now - ts))
  ((delta < 0)) && delta=0

  if ((delta < 60)); then printf '%ss' "$delta"
  elif ((delta < 3600)); then printf '%sm' "$((delta / 60))"
  elif ((delta < 86400)); then printf '%sh' "$((delta / 3600))"
  elif ((delta < 2592000)); then printf '%sd' "$((delta / 86400))"
  elif ((delta < 31536000)); then printf '%smo' "$((delta / 2592000))"
  else printf '%sy' "$((delta / 31536000))"
  fi
}

paint() {
  local text="$1"
  local color="$2"
  if [[ $USE_COLOR -eq 1 ]]; then
    printf '\033[%sm%s\033[0m' "$color" "$text"
  else
    printf '%s' "$text"
  fi
}

status_color() {
  case "$1" in
    clean\(*) echo '38;5;42' ;;
    conflict\(*) echo '1;38;5;160' ;;
    *dirty\(*) echo '38;5;196' ;;
    untracked\(*) echo '38;5;214' ;;
    no-commit) echo '38;5;245' ;;
    *) echo '38;5;245' ;;
  esac
}

remote_color() {
  case "$1" in
    up-to-date) echo '38;5;42' ;;
    ahead\?) echo '38;5;45' ;;
    behind\?) echo '38;5;214' ;;
    diverged\?) echo '1;38;5;196' ;;
    no-upstream|no-origin) echo '1;38;5;214' ;;
    *) echo '38;5;245' ;;
  esac
}

status_icon() {
  case "$1" in
    conflict\(*) echo '󰞇' ;;
    *dirty\(*) echo '󰅖' ;;
    untracked\(*) echo '󰞋' ;;
    clean\(*) echo '󰄬' ;;
    no-commit) echo '󰟢' ;;
    *) echo '󰋗' ;;
  esac
}

remote_icon() {
  case "$1" in
    up-to-date) echo '󰄬' ;;
    behind\?) echo '󰁞' ;;
    ahead\?) echo '󰁆' ;;
    diverged\?) echo '󰹹' ;;
    no-upstream|no-origin) echo '󰞏' ;;
    *) echo '󰋗' ;;
  esac
}

format_status_text() {
  local s="$1" pad c
  printf -v pad "%-${STATUS_W}s" "$s"
  c="$(status_color "$s")"
  paint "$pad" "$c"
}

format_remote_text() {
  local r="$1" pad c
  printf -v pad "%-${REMOTE_W}s" "$r"
  c="$(remote_color "$r")"
  paint "$pad" "$c"
}

build_mr_config() {
  local -a dirs repos
  mapfile -t dirs < <(fd --type d --min-depth 1 --max-depth 1 . "$CODE_ROOT" 2>/dev/null || true)

  repos=()
  for d in "${dirs[@]}"; do
    [[ -d "$d/.git" ]] && repos+=("$d")
  done

  [[ ${#repos[@]} -eq 0 ]] && die "No git repositories found under $(display_path "$CODE_ROOT")."

  : > "$CACHE_CONFIG"
  for d in "${repos[@]}"; do
    printf '[%s]\n' "$d" >> "$CACHE_CONFIG"
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) REBUILD=1 ;;
    --verbose) VERBOSE=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "Unknown option: $1" ;;
  esac
  shift
done

[[ -t 1 ]] && USE_COLOR=1

command -v fd >/dev/null 2>&1 || die "Missing dependency: fd"
command -v mr >/dev/null 2>&1 || die "Missing dependency: mr"
[[ -x "$PROBE" ]] || die "Missing executable probe script: $PROBE"

if command -v gum >/dev/null 2>&1; then
  LABEL_MINE="$(gum style --foreground 255 --background 29 --width "$LABEL_W" --align center 'mine')"
  LABEL_3P="$(gum style --foreground 255 --background 240 --width "$LABEL_W" --align center '3p')"
else
  printf -v LABEL_MINE "%-${LABEL_W}s" "mine"
  printf -v LABEL_3P "%-${LABEL_W}s" "3p"
fi

[[ -d "$CODE_ROOT" ]] || die "No code directory found at $(display_path "$CODE_ROOT")."

mkdir -p "$CACHE_DIR" "$CACHE_HOME"
if [[ $REBUILD -eq 1 || ! -s "$CACHE_CONFIG" ]]; then
  build_mr_config
fi

echo "git status for repos in ~/code"

RAW="$(mktemp)"
trap 'rm -f "$RAW"' EXIT

total="$(grep -c '^\[' "$CACHE_CONFIG" || true)"
[[ -z "$total" || "$total" -eq 0 ]] && total=1

count=0
SECONDS=0
while IFS= read -r line; do
  if [[ "$line" == "mr run: "* ]]; then
    repo_path="${line#mr run: }"
    if [[ "$repo_path" == /* ]]; then
      ((count+=1))
      if [[ -t 1 ]]; then
        printf '\r\033[2K[%d/%d] %ss checking %s' "$count" "$total" "$SECONDS" "$(display_path "$repo_path")"
      fi
    fi
    continue
  fi

  [[ -z "$line" ]] && continue
  printf '%s\n' "$line" >> "$RAW"
done < <(HOME="$CACHE_HOME" mr -j "$MR_JOBS" --trust-all -c "$CACHE_CONFIG" -d / -m run "$PROBE")

if [[ -t 1 ]]; then
  printf '\r\033[2K[%d/%d] %ss done\n' "$count" "$total" "$SECONDS"
fi

while IFS=$'\t' read -r repo status remote last_ts origin; do
  [[ -z "${repo:-}" ]] && continue

  label="$LABEL_3P"
  rank=2
  if [[ -z "${origin:-}" || "$origin" =~ $OWN_RE ]]; then
    label="$LABEL_MINE"
    rank=1
  fi

  age='-'
  [[ -n "${last_ts:-}" ]] && age="$(age_from_epoch "$last_ts")"

  repo_disp="$(display_path "$repo")"

  if [[ $VERBOSE -eq 1 ]]; then
    s_col="$(format_status_text "$status")"
    r_col="$(format_remote_text "$remote")"
    printf -v age_col "%-${LAST_W}s" "$age"
    line="  $label  $s_col  $r_col  $age_col  $repo_disp"
  else
    s_icon="$(status_icon "$status")"
    r_icon="$(remote_icon "$remote")"
    s_col="$(paint "$s_icon" "$(status_color "$status")")"
    r_col="$(paint "$r_icon" "$(remote_color "$remote")")"
    printf -v s_col "%-${ICON_W}s" "$s_col"
    printf -v r_col "%-${ICON_W}s" "$r_col"
    printf -v age_col "%-${LAST_W}s" "$age"
    line="  $label  $s_col  $r_col  $age_col  $repo_disp"
  fi

  printf '%s\t%s\t%s\n' "$rank" "$repo_disp" "$line"
done < <(awk '!/^mr run:/ && NF' "$RAW") | sort -t $'\t' -k1,1n -k2,2 | cut -f3-
