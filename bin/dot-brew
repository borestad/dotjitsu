#!/usr/bin/env bash
set -Eeuo pipefail

date "+%F %T"

cd "$(dirname "$0")"
ROOT=$(git rev-parse --show-toplevel)
HOMEBREW_PREFIX=$(/opt/homebrew/bin/brew --prefix)

# .env$ expects some vars to maybe be unset in non-interactive shells.
# Keep strict mode for the script, but source env with nounset temporarily off.
set +u
# shellcheck disable=SC1090
source "$ROOT/.env$"
set -u

# Setup
LOG_LOCATION="$HOME/logs/brew"
export TERM="xterm-256color"
export COLS=100
export ROWS=30
mkdir -p "$LOG_LOCATION"
export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"

export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1

"$HOME/.dotjitsu/bin/hr" -
echo "brew update"
echo
ets -s -f "%s.%Ls ┃ " 2>/dev/null memo --ttl=60min -- brew -v update

"$HOME/.dotjitsu/bin/hr" -
echo "brew bundle (Brewfile.core)"
echo
ets -s -f "%s.%Ls ┃ " 2>/dev/null brew -v bundle --file="$HOME/.dotjitsu/Brewfile.core"

"$HOME/.dotjitsu/bin/hr" -
echo "brew bundle (Brewfile)"
echo
ets -s -f "%s.%Ls ┃ " 2>/dev/null brew -v bundle --file="$HOME/.dotjitsu/Brewfile"

"$HOME/.dotjitsu/bin/hr" -
echo "brew upgrade"
echo
ets -s -f "%s.%Ls ┃ " 2>/dev/null brew -v upgrade

rm -f "$HOMEBREW_PREFIX/share/zsh/site-functions/_git"

if command -v deno >/dev/null 2>&1; then
  chmod 711 "$(command -v deno)"
fi

echo
echo "All done!"
echo

date "+%F %T"
